PROJECT_NAME=CyberShield XDR
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
SECRET_KEY=<generate-a-strong-random-secret>
FIELD_ENCRYPTION_KEY=<generate-a-different-strong-random-secret>
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
POSTGRES_DB=<database-name>
POSTGRES_USER=<least-privilege-db-user>
POSTGRES_PASSWORD=<strong-generated-db-password>
DATABASE_URL=postgresql+psycopg://<user>:<password>@postgres:5432/<database>
REDIS_PASSWORD=<strong-generated-redis-password>
REDIS_URL=redis://:<password>@redis:6379/0
BACKEND_CORS_ORIGINS=https://<your-frontend-domain>
CORS_ALLOW_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOW_HEADERS=Authorization,Content-Type,X-Request-ID
ADMIN_BOOTSTRAP_EMAIL=<first-admin-email>
ADMIN_BOOTSTRAP_PASSWORD=<first-admin-temporary-password>
DEFAULT_PUBLIC_ROLE=Viewer
LOAD_DEMO_DATA=false
LOAD_TEST_DATA=false
AUTO_CREATE_TABLES=false
TEST_ADMIN_PASSWORD=<development-only-test-password>
TEST_SOC_PASSWORD=<development-only-test-password>
TEST_MALWARE_PASSWORD=<development-only-test-password>
TEST_VULN_PASSWORD=<development-only-test-password>
TEST_VIEWER_PASSWORD=<development-only-test-password>
SMTP_HOST=<smtp-host>
SMTP_PORT=587
SMTP_USERNAME=<smtp-username>
SMTP_PASSWORD=<smtp-password>
SMTP_FROM=<no-reply-address>
VIRUSTOTAL_API_KEY=<optional-provider-key>
ABUSEIPDB_API_KEY=<optional-provider-key>
OTX_API_KEY=<optional-provider-key>
